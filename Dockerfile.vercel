# ============================================================
# ETAPA 1: COMPILACIÓN
# ============================================================

FROM maven:3.9.9-eclipse-temurin-17 AS build

WORKDIR /app

COPY pom.xml .

COPY src ./src

RUN mvn clean package -DskipTests


# ============================================================
# ETAPA 2: TOMCAT
# ============================================================

FROM tomcat:10.1-jdk17

# Eliminar aplicaciones predeterminadas
RUN rm -rf /usr/local/tomcat/webapps/*

# Directorio para uploads
RUN mkdir -p /usr/local/tomcat/webapps/uploads

# Copiar WAR
COPY --from=build /app/target/MiPortafolio.war /usr/local/tomcat/webapps/MiPortafolio.war

# Crear script de inicio
RUN printf '#!/bin/sh\n\
PORT=${PORT:-8084}\n\
sed -i "s/port=\"8080\"/port=\"${PORT}\"/" /usr/local/tomcat/conf/server.xml\n\
exec catalina.sh run\n' > /usr/local/tomcat/start-vercel.sh \
&& chmod +x /usr/local/tomcat/start-vercel.sh

EXPOSE 8084

CMD ["/usr/local/tomcat/start-vercel.sh"]